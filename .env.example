#
# Example environment for the opensalestax-saleor app.
# Copy to `.env` and edit. NEVER commit a real `.env`.

# Public URL the app is reachable at (the URL you'll paste into
# Saleor's "Install external app" prompt). Must be http(s).
APP_API_BASE_URL=http://localhost:3000

# OpenSalesTax engine base URL. Reachable from inside the app
# container â€” typically the docker-compose service name.
OSTAX_API_URL=http://ost-engine:8080

# Optional: only set if your engine requires an API key.
# OSTAX_API_KEY=

# Per-request timeout to the engine (milliseconds). Default 5000.
# OSTAX_TIMEOUT_MS=5000

# Fail-hard: when set to "1", engine errors return webhook errors
# and block the checkout. Default (unset) is fail-soft: engine
# errors return empty tax and let Saleor fall back to catalog
# rates.
# OSTAX_FAIL_HARD=0

# APL seed values. Saleor's install POST writes these; copy them
# from the app's stdout after install and re-set here so the app
# survives container restarts.
# SALEOR_API_URL=https://your-saleor.example.com/graphql/
# SALEOR_APP_ID=...
# SALEOR_APP_TOKEN=...

# Optional: override the OST engine's Postgres password used by the
# example docker-compose.yml. Default "ost" (fine for local dev,
# NOT for production).
# OSTAX_DB_PASSWORD=ost
