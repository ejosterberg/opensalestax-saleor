{
  "name": "@ejosterberg/saleor-app-opensalestax",
  "version": "1.1.0",
  "description": "Saleor Tax App connector — destination-based US sales tax via the self-hosted OpenSalesTax engine",
  "license": "Apache-2.0",
  "author": "Eric Osterberg <ejosterberg@gmail.com>",
  "homepage": "https://github.com/ejosterberg/opensalestax-saleor",
  "bugs": {
    "url": "https://github.com/ejosterberg/opensalestax-saleor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejosterberg/opensalestax-saleor.git"
  },
  "keywords": [
    "saleor",
    "tax",
    "sales-tax",
    "opensalestax",
    "us-tax",
    "tax-provider"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test -- --coverage && npm audit --omit=dev --audit-level=high",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@saleor/app-sdk": "^1.8.0",
    "graphql": "^16.10.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
